import { TrendingUp, Target, Clock, CheckCircle, ArrowUpRight, AlertCircle } from 'lucide-react';
import { fmt, fmtDate, weightedValue, initials } from '../lib/data';

export default function Dashboard({ data }) {
  const { deals, companies, contacts, documents } = data;
  const active = deals.filter(d => !['Won','Lost','Archive'].includes(d.stage));
  const won = deals.filter(d => d.stage === 'Won');
  const pipeline = active.reduce((s,d) => s+d.value, 0);
  const weighted = weightedValue(deals);
  const closing = active.filter(d => d.expectedClose && new Date(d.expectedClose) <= new Date(Date.now() + 30*24*60*60*1000));

  const stageOrder = ['Lead','Qualification','Proposal','Negotiation','Won'];
  const byStage = stageOrder.map(s => ({ stage:s, count:deals.filter(d=>d.stage===s).length, value:deals.filter(d=>d.stage===s).reduce((a,b)=>a+b.value,0) }));
  const maxVal = Math.max(...byStage.map(s=>s.value), 1);

  const hotDeals = deals.filter(d => ['Proposal','Negotiation'].includes(d.stage)).sort((a,b) => b.value-a.value);

  return (
    <div style={{ padding:'28px 32px', display:'flex', flexDirection:'column', gap:24 }}>
      {/* Header */}
      <div>
        <h1 style={{ fontSize:22, fontWeight:700, color:'#0F1921', letterSpacing:'-0.02em' }}>Good morning, Craig</h1>
        <p style={{ color:'#9BA5AF', fontSize:13, marginTop:2 }}>Here's your pipeline overview for today.</p>
      </div>

      {/* Stats row */}
      <div style={{ display:'grid', gridTemplateColumns:'repeat(4,1fr)', gap:16 }}>
        {[
          { label:'Total Pipeline', value:fmt(pipeline), delta:'6 active deals', icon:TrendingUp, color:'#C6A969' },
          { label:'Weighted Forecast', value:fmt(weighted), delta:'Probability-adjusted', icon:Target, color:'#60A5FA' },
          { label:'Closing This Month', value:closing.length, delta:closing.length ? fmt(closing.reduce((a,b)=>a+b.value,0)) : 'No deals closing soon', icon:Clock, color:'#FB923C' },
          { label:'Won This Year', value:fmt(won.reduce((a,b)=>a+b.value,0)), delta:`${won.length} deal${won.length!==1?'s':''}`, icon:CheckCircle, color:'#4ADE80' },
        ].map(({label,value,delta,icon:Icon,color}) => (
          <div key={label} className="stat-card" style={{ position:'relative', overflow:'hidden' }}>
            <div style={{ display:'flex', alignItems:'flex-start', justifyContent:'space-between', marginBottom:12 }}>
              <span className="stat-label">{label}</span>
              <div style={{ width:32, height:32, borderRadius:8, background:color+'18', display:'flex', alignItems:'center', justifyContent:'center' }}>
                <Icon size={15} color={color} />
              </div>
            </div>
            <div className="stat-value">{value}</div>
            <div className="stat-delta">{delta}</div>
            <div style={{ position:'absolute', bottom:0, left:0, right:0, height:3, background:color, opacity:0.6, borderRadius:'0 0 8px 8px' }} />
          </div>
        ))}
      </div>

      {/* Pipeline bar + Hot deals */}
      <div style={{ display:'grid', gridTemplateColumns:'1fr 1.4fr', gap:20 }}>
        {/* Pipeline by stage */}
        <div className="card" style={{ padding:20 }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:20 }}>
            <h2 style={{ fontSize:14, fontWeight:600, color:'#0F1921' }}>Pipeline by Stage</h2>
          </div>
          <div style={{ display:'flex', flexDirection:'column', gap:12 }}>
            {byStage.map(({stage,count,value}) => (
              <div key={stage}>
                <div style={{ display:'flex', justifyContent:'space-between', marginBottom:5 }}>
                  <span style={{ fontSize:12, fontWeight:500, color:'#5A6472' }}>{stage}</span>
                  <span style={{ fontSize:12, fontWeight:600, color:'#0F1921' }}>{fmt(value)} <span style={{ color:'#9BA5AF', fontWeight:400 }}>({count})</span></span>
                </div>
                <div style={{ height:6, background:'#F4F2EF', borderRadius:3, overflow:'hidden' }}>
                  <div style={{ height:'100%', width:`${(value/maxVal)*100}%`, background: stage==='Won'?'#4ADE80':stage==='Negotiation'?'#FB923C':stage==='Proposal'?'#C6A969':stage==='Qualification'?'#60A5FA':'#CBD5E0', borderRadius:3, transition:'width 0.4s' }} />
                </div>
              </div>
            ))}
          </div>
        </div>

        {/* Hot deals */}
        <div className="card" style={{ padding:20 }}>
          <div style={{ display:'flex', alignItems:'center', justifyContent:'space-between', marginBottom:16 }}>
            <h2 style={{ fontSize:14, fontWeight:600, color:'#0F1921' }}>Hot Deals <span style={{ color:'#9BA5AF', fontWeight:400 }}>— Proposal & Negotiation</span></h2>
          </div>
          {hotDeals.length === 0 ? <div style={{ color:'#9BA5AF', fontSize:13, textAlign:'center', padding:'20px 0' }}>No hot deals right now</div> : (
            <div style={{ display:'flex', flexDirection:'column', gap:1 }}>
              {hotDeals.map(deal => {
                const co = data.companies.find(c=>c.id===deal.companyId);
                return (
                  <div key={deal.id} style={{ display:'flex', alignItems:'center', gap:12, padding:'10px 0', borderBottom:'1px solid #F4F2EF' }}>
                    <div style={{ width:36, height:36, borderRadius:8, background:'#F4F2EF', display:'flex', alignItems:'center', justifyContent:'center', fontSize:11, fontWeight:700, color:'#0F1921', flexShrink:0 }}>
                      {initials(co?.name||'?')}
                    </div>
                    <div style={{ flex:1, minWidth:0 }}>
                      <div style={{ fontWeight:600, fontSize:13, color:'#0F1921', whiteSpace:'nowrap', overflow:'hidden', textOverflow:'ellipsis' }}>{deal.title}</div>
                      <div style={{ fontSize:11, color:'#9BA5AF' }}>{co?.name} · Close {fmtDate(deal.expectedClose)}</div>
                    </div>
                    <div style={{ textAlign:'right', flexShrink:0 }}>
                      <div style={{ fontWeight:700, fontSize:13, color:'#0F1921' }}>{fmt(deal.value)}</div>
                      <span className={`stage-badge stage-${deal.stage}`}>{deal.stage}</span>
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>

      {/* Recent docs + activity */}
      <div style={{ display:'grid', gridTemplateColumns:'1fr 1fr', gap:20 }}>
        <div className="card" style={{ padding:20 }}>
          <h2 style={{ fontSize:14, fontWeight:600, marginBottom:16 }}>Recent Documents</h2>
          {documents.slice(0,4).map(doc => (
            <div key={doc.id} style={{ display:'flex', alignItems:'center', gap:10, padding:'8px 0', borderBottom:'1px solid #F4F2EF' }}>
              <div style={{ width:32, height:32, borderRadius:6, background:'#FEF3C7', display:'flex', alignItems:'center', justifyContent:'center', fontSize:10, fontWeight:700, color:'#92400E' }}>PDF</div>
              <div style={{ flex:1, minWidth:0 }}>
                <div style={{ fontSize:12, fontWeight:500, color:'#0F1921', whiteSpace:'nowrap', overflow:'hidden', textOverflow:'ellipsis' }}>{doc.name}</div>
                <div style={{ fontSize:11, color:'#9BA5AF' }}>{doc.type} · {doc.size} · {fmtDate(doc.uploadedAt)}</div>
              </div>
              <ArrowUpRight size={13} color="#9BA5AF" />
            </div>
          ))}
        </div>

        <div className="card" style={{ padding:20 }}>
          <h2 style={{ fontSize:14, fontWeight:600, marginBottom:16 }}>Recent Activity</h2>
          {data.activities.slice(0,4).map(a => {
            const deal = deals.find(d=>d.id===a.dealId);
            return (
              <div key={a.id} style={{ display:'flex', gap:10, padding:'8px 0', borderBottom:'1px solid #F4F2EF' }}>
                <div style={{ width:6, height:6, borderRadius:'50%', background:'#C6A969', marginTop:5, flexShrink:0 }} />
                <div>
                  <div style={{ fontSize:12, color:'#0F1921' }}>{a.text}</div>
                  <div style={{ fontSize:11, color:'#9BA5AF', marginTop:2 }}>{deal?.title} · {fmtDate(a.date)}</div>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}
